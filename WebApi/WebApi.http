@WebApi_HostAddress = http://localhost:5169

### Get all products
GET {{WebApi_HostAddress}}/api/product
Accept: application/json

### Get a product
GET {{WebApi_HostAddress}}/api/product/1
Accept: application/json

### Get products by category
GET {{WebApi_HostAddress}}/api/product/category/1
Accept: application/json

### Create a product
POST {{WebApi_HostAddress}}/api/product
Content-Type: application/json

{
  "name": "Wireless Mouse",
  "price": 29.99,
  "quantity": 10,
  "categoryId": 1
}

### Update a product
PUT {{WebApi_HostAddress}}/api/product/1
Content-Type: application/json

{
  "name": "Wireless Mouse",
  "price": 24.99,
  "quantity": 15,
  "categoryId": 1
}

### Delete a product
DELETE {{WebApi_HostAddress}}/api/product/1

### Get product count
GET {{WebApi_HostAddress}}/api/product/statistics/count
Accept: application/json

### Get product count by category
GET {{WebApi_HostAddress}}/api/product/statistics/category/1/count
Accept: application/json

### Get minimum product price by category
GET {{WebApi_HostAddress}}/api/product/statistics/category/1/min-price
Accept: application/json

### Get maximum product price by category
GET {{WebApi_HostAddress}}/api/product/statistics/category/1/max-price
Accept: application/json

### Get average product price by category
GET {{WebApi_HostAddress}}/api/product/statistics/category/1/average-price
Accept: application/json

### Get total product price
GET {{WebApi_HostAddress}}/api/product/statistics/total-price
Accept: application/json

### Get all categories
GET {{WebApi_HostAddress}}/api/category
Accept: application/json

### Get a category
GET {{WebApi_HostAddress}}/api/category/1
Accept: application/json

### Create a category
POST {{WebApi_HostAddress}}/api/category
Content-Type: application/json

{
  "name": "Accessories"
}

### Update a category
PUT {{WebApi_HostAddress}}/api/category/1
Content-Type: application/json

{
  "name": "Computer Accessories"
}

### Delete a category
DELETE {{WebApi_HostAddress}}/api/category/1

### Get category count
GET {{WebApi_HostAddress}}/api/category/statistics/count
Accept: application/json

### Example not-found response
GET {{WebApi_HostAddress}}/api/product/999999
Accept: application/json
